# ── Friend2Friend — environment template ───────────────────────────────────
# Copy this file to `.env.local` and fill in the values from your Supabase
# project, then restart `npm run dev`.
#
#   cp .env.example .env.local
#
# Find these in the Supabase dashboard:
#   Settings → API     → Project URL + anon/public key + service_role key
#   Settings → Database → Connection string (Session pooler URI)

# ── Client (Vite exposes only VITE_*-prefixed vars to the browser) ───────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Admin scripts only (NEVER expose these to the client) ────────────────────
# Used by:  npm run seed       (scripts/seed-demo-users.mjs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by:  npm run db:apply   (scripts/db-apply.mjs)
# Session pooler URI with your DB password filled in, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=your-session-pooler-connection-string
